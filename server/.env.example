# MongoDB Connection String (Use MongoDB Atlas for production)
MONGO_URI=mongodb://localhost:27017/hotelflow_db

# Server Port
PORT=5000

# JWT Secret Key — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed frontend origins (production)
# FRONTEND_URL=https://your-frontend.vercel.app
# CLIENT_URLS=https://your-frontend.vercel.app,https://your-preview.vercel.app
FRONTEND_URL=http://localhost:3000
# Allow any *.vercel.app origin (preview deployments). Keep false unless needed.
ALLOW_VERCEL_PREVIEWS=false

# Demo accounts (created automatically, passwords hashed in MongoDB).
# Set DEMO_LOGIN_ENABLED=false to disable seeding and the public credentials card.
DEMO_LOGIN_ENABLED=true
DEMO_ADMIN_NAME=HotelFlow Admin
DEMO_ADMIN_EMAIL=admin@hotelflow.com
DEMO_ADMIN_PASSWORD=admin123
DEMO_ADMIN_PHONE=+10000000001
DEMO_USER_NAME=Demo Guest
DEMO_USER_EMAIL=user@hotelflow.com
DEMO_USER_PASSWORD=user123
DEMO_USER_PHONE=+10000000002

# Cloudinary Configuration (if using image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# AI Travel Assistant (optional — server-side only, never exposed to the client)
# Without these, the assistant uses a built-in guide grounded in live hotel data.
# AI_PROVIDER=openai
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sk-your-key-here
# AI_MODEL=gpt-4o-mini
